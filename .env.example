DB_PATH=data/safe_orch.db
OPENAI_API_KEY=
OPENAI_MODEL=
# 비추론 모델이면 TEMPERATURE=0·SEED=0, 추론 모델이면 두 값을 비우고 REASONING_EFFORT를 가장 낮게.
# 빈 값은 ChatOpenAI에 넘기지 않는다.
OPENAI_TEMPERATURE=
OPENAI_SEED=
OPENAI_REASONING_EFFORT=
DEMO_MODE=true
LANGSMITH_TRACING=false
# Agent 자동 시작 스위치(기본 true). false면 Coordination 대신 Supervisor 검토 대기(기본안 B)·통지 없음,
# Event Response 대신 지연 신고에 Hold만(Scene 4). 테스트는 .env를 읽지 않고 conftest가 둘 다 끈다.
COORDINATION_ENABLED=true
EVENT_RESPONSE_ENABLED=true
# 현장의 지금(ST-17). ISO 8601에 오프셋이 반드시 있어야 한다(없으면 기동 실패). 비우면 실제 시계.
# Agent에게 알려 주기만 하고 판정·계산에는 쓰지 않는다. 시연 Pack의 계획 첫날 09:00(KST)로 둔다.
SITE_NOW=2026-10-12T09:00+09:00
