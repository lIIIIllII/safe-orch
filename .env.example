DB_PATH=data/safe_orch.db
OPENAI_API_KEY=
OPENAI_MODEL=
# 비추론 모델이면 TEMPERATURE=0·SEED=0, 추론 모델이면 두 값을 비우고 REASONING_EFFORT를 가장 낮게.
# 빈 값은 ChatOpenAI에 넘기지 않는다.
OPENAI_TEMPERATURE=
OPENAI_SEED=
OPENAI_REASONING_EFFORT=
DEMO_MODE=true
LANGSMITH_TRACING=false
# 사건 → 메인 자동 시작(기본 true). false면 사건은 기록만 되고 메인 Agent가 뜨지 않는다
# (전문 Agent는 메인이 부를 때만 돈다). 테스트는 .env를 읽지 않고 conftest가 끈다.
MAIN_AUTO_START=true
# 메인 Agent Budget: step 수와 전문 Agent 호출 수
MAIN_MAX_STEPS=12
MAIN_MAX_AGENT_CALLS=8
# 현장의 지금(ST-17). ISO 8601에 오프셋이 반드시 있어야 한다(없으면 기동 실패). 비우면 실제 시계.
# Agent에게 알려 주기만 하고 판정·계산에는 쓰지 않는다. 시연 Pack의 계획 첫날 09:00(KST)로 둔다.
SITE_NOW=2026-10-12T09:00+09:00
